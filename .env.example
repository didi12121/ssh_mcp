PTMCP_HOST=127.0.0.1
PTMCP_PORT=8766
# PTMCP_ALLOWED_HOSTS=["mcp.internal.example:8766"]
PTMCP_DATA_DIR=.data/terminal
# PTMCP_DATABASE_URL=sqlite+aiosqlite:///./.data/terminal/terminal.db
PTMCP_KNOWN_HOSTS=.data/terminal/known_hosts
PTMCP_PRINCIPALS_FILE=.data/terminal/principals.json
PTMCP_CREDENTIALS_FILE=.data/terminal/credentials.json
# PTMCP_MASTER_KEY_FILE=.data/terminal/master.key
# PTMCP_SSH_AGENT_PATH=/run/user/1000/ssh-agent.sock
# PTMCP_WEB_ADMIN_TOKEN_FILE=/home/operator/ssh-mcp/.data/admin-token
# PTMCP_MANAGED_KEYS_DIR=/home/operator/ssh-mcp/.data/keys
PTMCP_CONNECT_TIMEOUT=15
PTMCP_KEEPALIVE_INTERVAL=30
PTMCP_IDLE_TIMEOUT=3600
PTMCP_RECONNECT_ATTEMPTS=3
PTMCP_RECOVERY_ENABLED=true
PTMCP_ALLOW_PTY_FALLBACK=false
PTMCP_MAX_SESSIONS_PER_AGENT=20
PTMCP_TOKEN_DEFAULT_DAYS=90
PTMCP_TOKEN_USAGE_INTERVAL_SECONDS=60
PTMCP_ADMIN_TOKEN_MUTATIONS_PER_MINUTE=30
PTMCP_MAX_EXECUTIONS_PER_SESSION=10
PTMCP_EXECUTION_TIMEOUT=3600
PTMCP_OUTPUT_MAX_BYTES=10485760
PTMCP_OUTPUT_RETENTION_DAYS=7
PTMCP_LOG_LEVEL=INFO
