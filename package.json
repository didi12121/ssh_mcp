{
  "name": "local-ssh-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A policy-constrained STDIO and intranet HTTP MCP server for read-only SSH operations.",
  "type": "module",
  "bin": {
    "local-ssh-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "token:create": "node dist/token-cli.js create",
    "token:list": "node dist/token-cli.js list",
    "token:revoke": "node dist/token-cli.js revoke",
    "test": "npm run build && node --import tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}
